# Supabase Postgres (Project Settings → Database → Connection string)
# Local dev + migrations: Session mode, port 5432
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Vercel production: Transaction mode, port 6543 (set in Vercel env vars, not locally)
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# Used to encrypt JWT tokens (generate a random 32+ character string)
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs (required on Vercel)
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests (required on Vercel)
PREVIEW_SECRET=YOUR_SECRET_HERE

# Production only (Vercel): set automatically when Blob storage is linked to the project.
# Not required for local dev — media uses public/media on disk instead.
# BLOB_READ_WRITE_TOKEN=

# Production email (Resend): https://resend.com
# RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=DIGITAILOR <noreply@yourdomain.com>
# DISCOVERY_CALL_NOTIFY_EMAIL=hello@yourdomain.com

# Dev only: enables destructive "Seed database" in admin + POST /next/seed. Never set in production.
# SEED_ENABLED=true
